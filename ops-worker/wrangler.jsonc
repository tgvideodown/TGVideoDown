{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "product-ops",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // 账号、密码、token 只放 Cloudflare Dashboard，部署时不要覆盖线上变量
  "keep_vars": true,
  "services": [
    {
      "binding": "BILLING_IGEXPORT",
      "service": "ig-exporter-billing"
    },
    {
      "binding": "BILLING_IGCOMMENT",
      "service": "ig-comment-billing"
    },
    {
      "binding": "BILLING_FBDOWNLOAD",
      "service": "fb-downloader-billing"
    },
    {
      "binding": "BILLING_TGDOWNLOAD",
      "service": "tg-downloader-billing"
    },
    {
      "binding": "SITE_IGWEB",
      "service": "ig-exporter-api"
    },
    {
      "binding": "OPS_IGEXPORT_VEST",
      "service": "igexport-vest-ops"
    }
  ],
  "vars": {
    "TOKEN_FBDOWNLOAD": "fbOps_7kQm2nVx9pL4sR8wT3yH6cD1aB5e",
    "TOKEN_XUNFOLLOW": "xUnfollowOps_k4R9mW2pL7nQ8vT3cH6sD1aB5eY0",
    "TOKEN_IGEXPORT_VEST": "igVestOps_9kQm2nVx7pL4sR8wT3yH6cD1aB5e"
  }
}
